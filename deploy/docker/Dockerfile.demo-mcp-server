FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o /out/demo-mcp-server ./cmd/demo-mcp-server

FROM gcr.io/distroless/static-debian12
COPY --from=build /out/demo-mcp-server /demo-mcp-server
EXPOSE 9090
ENTRYPOINT ["/demo-mcp-server"]
